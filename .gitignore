# .gitignore

# Sensitive files
.env
servers.db
key.key
command_log_*.txt
config.json

# PyInstaller build artifacts
build/
dist/
*.spec

# Python virtual environment
.venv/
venv/

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# VS Code settings and cache
.vscode/
*.code-workspace

# Temporary files
*.tmp
*.bak
*.swp
*~

# macOS-specific files
.DS_Store

# Windows-specific files
Thumbs.db
desktop.ini